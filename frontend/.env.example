# このファイルをコピーして .env.local を作り、実際の値を入れて使う。
# .env.local はgit管理対象外。

# バックエンドのURL。未設定時は同一オリジンの /api を叩く。
# ホーム/勉強/マップ/タスク/チャットの全画面が共通でこの変数を使う。
VITE_API_URL=

# （任意）AIチューターだけ別オリジンに向けたい場合のみ設定する。
# 未設定時は VITE_API_URL と同じURLを使う。
VITE_AI_TUTOR_URL=

# Google Maps JavaScript API用のキー。取得方法はREADME等を参照。
# HTTPリファラー制限をかけた前提の公開用キーであり、秘密鍵ではない。
VITE_GOOGLE_MAPS_API_KEY=
