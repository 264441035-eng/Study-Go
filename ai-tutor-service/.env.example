# AI Tutor Service - 環境変数サンプル
# cp .env.example .env して調整。

APP_ENV=local

# --- 依存モード ---
LLM_MODE=mock            # mock | bedrock
BACKEND_MODE=mock        # mock | real
DATABASE_MODE=memory     # memory | local | aws
RAG_MODE=mock            # mock | bedrock  (Phase1 は mock 固定)

# --- Bedrock (LLM_MODE=bedrock のとき) ---
BEDROCK_REGION=us-east-1
CONVERSATION_MODEL_ID=   # 会話 = Claude Haiku 4.5 系 (pin; region availability 要確認)
ASSESSMENT_MODEL_ID=     # 評価 = Claude Sonnet 5 系 (pin)

# --- 認証 (JWT HS256, 既存backendと同じシークレット) ---
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256

# --- 既存 Backend (BACKEND_MODE=real のとき) ---
EXISTING_BACKEND_BASE_URL=http://localhost:8080

# --- DynamoDB (DATABASE_MODE=local|aws のとき) ---
DYNAMODB_ENDPOINT_URL=   # local は http://localhost:8000 等。aws は空
SESSIONS_TABLE=ai-tutor-sessions
STUDENT_MODELS_TABLE=ai-tutor-student-models

# --- コストの蓋 ---
MAX_TURNS=10
MAX_SESSIONS_PER_DAY=20
MAX_MESSAGE_CHARS=2000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
