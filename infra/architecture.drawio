        <!-- ===================== CI/CD lane ===================== -->
        <mxCell id="dev" value="開発者" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ghbox" value="GitHub&#10;（リポジトリ + Actions）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292E;fontColor=#ffffff;strokeColor=#24292E;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="210" y="70" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="&lt;b&gt;CI — .github/workflows/ci.yml&lt;/b&gt;&#10;（トリガ: pull_request）&#10;&#10;• backend : ruff + pytest（実 Postgres 16）&#10;• backend-smoke : docker build →&#10;&#160;&#160;alembic upgrade head → /health 疎通&#10;• frontend : eslint + vite build + vitest&#10;&#10;→ 全部グリーンで初めて main へマージ可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606A;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="110" width="270" height="210" as="geometry" />
        </mxCell>
        <mxCell id="deploy" value="&lt;b&gt;Deploy — .github/workflows/deploy.yml&lt;/b&gt;&#10;（トリガ: push → main）&#10;&#10;1. OIDC で IAM ロールを一時 assume&#10;&#160;&#160;（アクセスキー不要）&#10;2. docker build &amp; push → ECR&#10;&#160;&#160;（backend / frontend / ai-tutor）&#10;3. backend : run-task で&#10;&#160;&#160;alembic upgrade head（失敗で中断）&#10;4. ecs update-service（安定まで wait）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606A;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="270" height="210" as="geometry" />
        </mxCell>

